<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- 核心修復：強制瀏覽器在請求 YouTube 時提供完整的網址來源，防止觸發錯誤 153 -->
    <meta name="referrer" content="no-referrer-when-downgrade">
    <title>2026丙午年 高美白沙屯媽祖謁祖進香</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        
        body, html {
            width: 100%;
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #87CEEB; /* 天空藍背景 */
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        header {
            width: 100%;
            background-color: rgba(255, 255, 255, 0.85);
            text-align: center;
            padding: 12px 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            z-index: 10;
        }

        header h1 {
            color: #004080;
            font-size: 1.4rem;
            font-weight: bold;
        }

        .container {
            flex: 1;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: calc(100% - 50px);
        }

        .video-box {
            flex: 1;
            position: relative;
            width: 100%;
            background: #000;
        }

        .video-box iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        .map-box {
            flex: 1;
            width: 100%;
            background: #fff;
            border-top: 4px solid #004080;
        }

        .map-box iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        @media (max-width: 768px) {
            header h1 {
                font-size: 1.1rem;
            }
            .video-box {
                flex: 0.8;
            }
            .map-box {
                flex: 1.2;
            }
        }
    </style>
</head>
<body>

    <!-- 頁首標題 -->
    <header>
        <h1>2026丙午年 高美白沙屯媽祖謁祖進香</h1>
    </header>

    <!-- 主要內容（上下分割） -->
    <div class="container">
        <!-- 上方：YouTube 直播影片（轉換為隱私強化版路徑以繞過限制） -->
        <div class="video-box">
            <iframe 
                src="https://www.youtube.com/watch?v=V1p33hqPrUk" 
                title="YouTube video player" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                referrerpolicy="no-referrer-when-downgrade" 
                allowfullscreen>
            </iframe>
        </div>

        <!-- 下方：隨香地圖定位 -->
        <div class="map-box">
            <iframe 
                src="https://gps.godroad.tw/?sid=E260601" 
                title="隨香地圖定位">
            </iframe>
        </div>
    </div>

</body>
</html>
